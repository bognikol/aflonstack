{
  "name": "aflon-bootstrap",
  "version": "1.0.2",
  "description": "Bootstrap app for aflon web UI framework.",
  "scripts": {
    "start": "ws -d ./dist --spa index.html -p 9000",
    "start-studio": "ws -d ./dist --spa aflonStudio.html -p 9090",
    "build": "tsc -p tsconfig.json && webpack --config webpack.config.js"
  },
  "devDependencies": {
    "aflon-studio": "1.0.23",
    "local-web-server": "^4.2.1",
    "typescript": "~7.0.2",
    "webpack": "~5.95.0",
    "webpack-cli": "~5.1.4"
  },
  "dependencies": {
    "aflon": "^2.0.10"
  }
}
